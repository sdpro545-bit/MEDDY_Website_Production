# ==============================================================================
# MEDDY GLOBAL SOLUTIONS LTD — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# Configure these variables in the Vercel Project Dashboard for Production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base URLs
# ------------------------------------------------------------------------------
# Public website URL (used for canonical links, absolute sitemaps, and email logo hosting)
NEXT_PUBLIC_SITE_URL="https://www.meddyglobalsolutions.com"

# Hosted base URL for email image assets (must be an HTTPS public origin)
EMAIL_ASSET_BASE_URL="https://www.meddyglobalsolutions.com"

# ------------------------------------------------------------------------------
# 2. Resend Outbound Email Service
# ------------------------------------------------------------------------------
# API key generated from the Resend Dashboard (https://resend.com/api-keys)
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwx"

# Authorized sender identity matching authenticated domain
EMAIL_FROM="MEDDY GLOBAL SOLUTIONS LTD <info@meddyglobalsolutions.com>"

# Reply-To header for client inquiries
EMAIL_REPLY_TO="info@meddyglobalsolutions.com"

# Comma-separated destination mailboxes for website contact form notifications
EMAIL_INTERNAL_NOTIFICATION_TO="mglobalsolutions185@gmail.com,info@meddyglobalsolutions.com"

# ------------------------------------------------------------------------------
# 3. Secure Owner Compose Portal (/admin/login & /admin/compose)
# ------------------------------------------------------------------------------
# Set to "true" to activate the executive compose portal. Set to "false" to disable (returns 404).
ADMIN_COMPOSE_ENABLED="false"

# Admin portal username
ADMIN_USERNAME="meddyadmin"

# Scrypt cryptographic hash of the admin password.
# Generate with: node scripts/hash-password.mjs "YourSuperSecurePassword"
ADMIN_PASSWORD_HASH="scrypt$16384$8$1$0123456789abcdef0123456789abcdef$0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# 256-bit cryptographically secure session signing key (64 hex characters)
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Maximum outbound emails allowed per calendar day via the admin portal (default: 50)
ADMIN_DAILY_SEND_LIMIT="50"

